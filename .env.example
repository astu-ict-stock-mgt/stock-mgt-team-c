# Database
DATABASE_URL="file:./db/custom.db"

# Application
NODE_ENV=development
PORT=3000

# Express backend URL used by the Next.js frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Show the demo-account panel and pre-fill the login form.
# Development only — it prints a working password for six real accounts.
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS=false
