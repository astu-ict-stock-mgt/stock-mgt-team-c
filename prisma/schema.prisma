// ===================================================================
// Stock Management System — Prisma Schema (PostgreSQL)
// Phase 1: Domain Foundation (Store Hierarchy, Documents, Stock)
// ===================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------------
// AUTH & RBAC
// -------------------------------------------------------------------

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  username         String     @unique
  fullName         String
  passwordHash     String
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  department       String?
  phoneNumber      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  sessions             UserSession[]
  userRoles            UserRole[]
  auditLogs            AuditLog[]
  stockTransactions    StockTransaction[]
  requisitions         Requisition[]         @relation("RequisitionRequestedBy")
  requisitionApprovals RequisitionApproval[]
  stockTakes           StockTake[]
  gatePasses           GatePass[]            @relation("GatePassRequestedBy")
  gatePassesApproved   GatePass[]            @relation("GatePassSecurityOfficer")

  // Documents
  receipts             GoodsReceipt[]        @relation("ReceiptReceivedBy")
  grns                 GRN[]                 @relation("GRNGeneratedBy")
  evaluations          TechnicalEvaluation[] @relation("EvaluatedBy")
  sivsCreated          StoreIssueVoucher[]   @relation("SIVCreatedBy")
  sivsApproved         StoreIssueVoucher[]   @relation("SIVApprovedBy")
  returnsRequested     StoreReturnNote[]     @relation("ReturnRequestedBy")
  transfersRequested   TransferRequest[]     @relation("TransferRequestedBy")
  assets               FixedAsset[]          @relation("AssetResponsibleUser")
  userCard             UserCard?

  @@index([status])
  @@index([deletedAt])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  refresh   String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// -------------------------------------------------------------------
// SUPPLIERS
// -------------------------------------------------------------------

model Supplier {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  status        SupplierStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  receipts GoodsReceipt[]

  @@index([status])
  @@index([deletedAt])
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

// -------------------------------------------------------------------
// CATEGORIES & UOM
// -------------------------------------------------------------------

model Category {
  id          String     @id @default(cuid())
  code        String     @unique
  name        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items InventoryItem[]

  @@index([parentId])
}

model UnitOfMeasure {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())

  items InventoryItem[]
}

// -------------------------------------------------------------------
// MASTER DATA: STORE HIERARCHY
// Store -> Location -> Shelf -> Bin
// -------------------------------------------------------------------

model Store {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String      @unique
  type        String?     // e.g. "MAIN", "DEPARTMENT"
  department  String?
  location    String?
  status      StoreStatus @default(ACTIVE)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  locations          StoreLocation[]
  storeStocks        StoreStock[]
  receipts           GoodsReceipt[]
  sivs               StoreIssueVoucher[]
  transfersFrom      TransferRequest[]   @relation("TransferRequestFrom")
  transfersTo        TransferRequest[]   @relation("TransferRequestTo")
  stockTakes         StockTake[]
  fifoLayers         FifoLayer[]
  stockTransactions  StockTransaction[]
  stockCards         StockCard[]

  @@index([status])
  @@index([deletedAt])
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

model StoreLocation {
  id        String   @id @default(cuid())
  storeId   String
  code      String
  name      String
  createdAt DateTime @default(now())

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shelves Shelf[]

  @@unique([storeId, code])
}

model Shelf {
  id         String   @id @default(cuid())
  locationId String
  code       String
  name       String
  createdAt  DateTime @default(now())

  location StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  bins     Bin[]

  @@unique([locationId, code])
}

model Bin {
  id        String   @id @default(cuid())
  shelfId   String
  code      String
  name      String
  createdAt DateTime @default(now())

  shelf Shelf @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  
  binStocks BinStock[]
  binCards  BinCard[]
  receiptItems GoodsReceiptItem[]

  @@unique([shelfId, code])
}

// -------------------------------------------------------------------
// INVENTORY ITEMS
// -------------------------------------------------------------------

model InventoryItem {
  id             String        @id @default(cuid())
  code           String        @unique // SKU
  name           String
  description    String?
  categoryId     String
  uomId          String
  materialType   MaterialType  @default(CONSUMABLE)
  status         ItemStatus    @default(AVAILABLE)
  
  // Stock Control
  minStock       Float         @default(0)
  maxStock       Float         @default(0)
  safetyStock    Float         @default(0)
  reorderLevel   Float         @default(0)
  
  // Shelf Life (template data)
  hasShelfLife   Boolean       @default(false)
  shelfLifeDays  Int?

  unitCost       Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  category Category      @relation(fields: [categoryId], references: [id])
  uom      UnitOfMeasure @relation(fields: [uomId], references: [id])

  storeStocks      StoreStock[]
  binStocks        BinStock[]
  fifoLayers       FifoLayer[]
  receiptItems     GoodsReceiptItem[]
  sivItems         SIVItem[]
  transactions     StockTransaction[]
  stockCards       StockCard[]
  binCards         BinCard[]
  requisitionItems RequisitionItem[]
  transferItems    TransferRequestItem[]
  stockTakeItems   StockTakeItem[]
  fixedAssets      FixedAsset[]
  returnItems      StoreReturnItem[]
  disposalItems    DisposalItem[]

  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
}

enum MaterialType {
  CONSUMABLE
  NON_CONSUMABLE
  FIXED_ASSET
  OTHER
}

enum ItemStatus {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
  DAMAGED
  OBSOLETE
  DISPOSED
}

// -------------------------------------------------------------------
// STOCK TRACKING (STORE & BIN LEVEL)
// -------------------------------------------------------------------

model StoreStock {
  id          String   @id @default(cuid())
  itemId      String
  storeId     String
  quantity    Float    @default(0)
  reservedQty Float    @default(0)
  updatedAt   DateTime @updatedAt

  item  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  store Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([itemId, storeId])
  @@index([storeId])
}

model BinStock {
  id          String   @id @default(cuid())
  itemId      String
  binId       String
  quantity    Float    @default(0)
  reservedQty Float    @default(0)
  updatedAt   DateTime @updatedAt

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  bin  Bin           @relation(fields: [binId], references: [id], onDelete: Cascade)

  @@unique([itemId, binId])
  @@index([binId])
}

model FifoLayer {
  id             String   @id @default(cuid())
  itemId         String
  storeId        String
  grnId          String?  
  batchNumber    String?
  manufactureDate DateTime?
  expiryDate     DateTime?
  originalQty    Float
  remainingQty   Float
  unitCost       Float
  createdAt      DateTime @default(now())

  item  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  store Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  grn   GRN?          @relation(fields: [grnId], references: [id], onDelete: SetNull)

  @@index([itemId, storeId, createdAt])
  @@index([grnId])
  @@index([expiryDate])
}

// -------------------------------------------------------------------
// RECEIVING WORKFLOW: Goods Receipt -> TEC -> GRN
// -------------------------------------------------------------------

model GoodsReceipt {
  id              String        @id @default(cuid())
  code            String        @unique // RECP-YYYYMMDD-XXXX
  supplierId      String
  storeId         String
  receivedById    String
  status          ReceiptStatus @default(DRAFT)
  deliveryNote    String?
  purchaseOrder   String?
  inspectionNotes String?
  receiptDate     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  supplier   Supplier           @relation(fields: [supplierId], references: [id])
  store      Store              @relation(fields: [storeId], references: [id])
  receivedBy User               @relation("ReceiptReceivedBy", fields: [receivedById], references: [id])
  items      GoodsReceiptItem[]
  evaluation TechnicalEvaluation?
  grn        GRN?

  @@index([supplierId])
  @@index([storeId])
}

enum ReceiptStatus {
  DRAFT
  SUBMITTED
  UNDER_EVALUATION
  ACCEPTED
  REJECTED
  GRN_GENERATED
}

model GoodsReceiptItem {
  id        String @id @default(cuid())
  receiptId String
  itemId    String
  quantity  Float
  unitCost  Float
  condition String?
  binId     String?
  remarks   String?

  receipt GoodsReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [itemId], references: [id])
  bin     Bin?          @relation(fields: [binId], references: [id])
  evaluationItem TechnicalEvaluationItem?

  @@index([receiptId])
  @@index([binId])
}

model TechnicalEvaluation {
  id          String   @id @default(cuid())
  receiptId   String?  @unique
  returnId    String?  @unique
  evaluatorId String
  decision    EvaluationDecision
  comments    String?
  createdAt   DateTime @default(now())

  receipt   GoodsReceipt?             @relation(fields: [receiptId], references: [id])
  return    StoreReturnNote?          @relation(fields: [returnId], references: [id])
  evaluator User                      @relation("EvaluatedBy", fields: [evaluatorId], references: [id])
  items     TechnicalEvaluationItem[]
}

model TechnicalEvaluationItem {
  id                 String  @id @default(cuid())
  evaluationId       String
  goodsReceiptItemId String  @unique
  acceptedQuantity   Float   @default(0)
  rejectedQuantity   Float   @default(0)
  condition          String?
  decision           EvaluationDecision
  remarks            String?

  evaluation       TechnicalEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  goodsReceiptItem GoodsReceiptItem    @relation(fields: [goodsReceiptItemId], references: [id])

  @@index([evaluationId])
}

enum EvaluationDecision {
  APPROVED
  REJECTED
  APPROVED_WITH_CONDITIONS
  PENDING
}

model GRN {
  id            String   @id @default(cuid())
  code          String   @unique // GRN-YYYYMMDD-XXXX
  receiptId     String   @unique
  generatedById String
  date          DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  receipt     GoodsReceipt @relation(fields: [receiptId], references: [id])
  generatedBy User         @relation("GRNGeneratedBy", fields: [generatedById], references: [id])
  fifoLayers  FifoLayer[]
  assets      FixedAsset[]
}

// -------------------------------------------------------------------
// ISSUING WORKFLOW: Requisition -> SIV -> Final Issue
// -------------------------------------------------------------------

model Requisition {
  id            String            @id @default(cuid())
  code          String            @unique // REQ-YYYYMMDD-XXXX
  requestedById String
  department    String
  status        RequisitionStatus @default(DRAFT)
  requiredDate  DateTime
  purpose       String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  requestedBy User                  @relation("RequisitionRequestedBy", fields: [requestedById], references: [id])
  items       RequisitionItem[]
  approvals   RequisitionApproval[]
  sivs        StoreIssueVoucher[]

  @@index([status])
  @@index([requestedById])
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

model RequisitionItem {
  id            String @id @default(cuid())
  requisitionId String
  itemId        String
  quantity      Float
  fulfilledQty  Float  @default(0)

  requisition Requisition   @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id])

  @@index([requisitionId])
}

model RequisitionApproval {
  id            String         @id @default(cuid())
  requisitionId String
  approverId    String
  status        ApprovalStatus
  comments      String?
  approvedAt    DateTime       @default(now())

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  approver    User        @relation(fields: [approverId], references: [id])

  @@index([requisitionId])
}

enum ApprovalStatus {
  APPROVED
  REJECTED
  RETURNED_FOR_CORRECTION
}

model StoreIssueVoucher {
  id            String    @id @default(cuid())
  code          String    @unique // SIV-YYYYMMDD-XXXX
  requisitionId String?
  storeId       String
  createdById   String
  approvedById  String?
  status        SIVStatus @default(DRAFT)
  issueDate     DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requisition Requisition? @relation(fields: [requisitionId], references: [id])
  store       Store        @relation(fields: [storeId], references: [id])
  createdBy   User         @relation("SIVCreatedBy", fields: [createdById], references: [id])
  approvedBy  User?        @relation("SIVApprovedBy", fields: [approvedById], references: [id])
  items       SIVItem[]
  gatePass    GatePass?

  @@index([storeId])
  @@index([status])
}

enum SIVStatus {
  DRAFT
  PRELIMINARY
  UNDER_APPROVAL
  AMENDMENT_REQUIRED
  APPROVED
  FINALIZED
  ISSUED
}

model SIVItem {
  id          String @id @default(cuid())
  sivId       String
  itemId      String
  quantity    Float
  approvedQty Float  @default(0)
  issuedQty   Float  @default(0)
  unitCost    Float  @default(0) 

  siv  StoreIssueVoucher @relation(fields: [sivId], references: [id], onDelete: Cascade)
  item InventoryItem     @relation(fields: [itemId], references: [id])

  @@index([sivId])
}

// -------------------------------------------------------------------
// RETURNS WORKFLOW
// -------------------------------------------------------------------

model StoreReturnNote {
  id            String       @id @default(cuid())
  code          String       @unique // SRN-YYYYMMDD-XXXX
  requestedById String
  department    String
  originalSivId String?
  status        ReturnStatus @default(DRAFT)
  date          DateTime     @default(now())
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  requestedBy User                 @relation("ReturnRequestedBy", fields: [requestedById], references: [id])
  items       StoreReturnItem[]
  evaluation  TechnicalEvaluation?
}

enum ReturnStatus {
  DRAFT
  SUBMITTED
  UNDER_EVALUATION
  APPROVED
  REJECTED
  POSTED
}

model StoreReturnItem {
  id        String  @id @default(cuid())
  srnId     String
  itemId    String
  quantity  Float
  reason    String?
  condition String?

  srn  StoreReturnNote @relation(fields: [srnId], references: [id], onDelete: Cascade)
  item InventoryItem   @relation(fields: [itemId], references: [id])
}

// -------------------------------------------------------------------
// TRANSFERS WORKFLOW
// -------------------------------------------------------------------

model TransferRequest {
  id            String         @id @default(cuid())
  code          String         @unique // TRF-YYYYMMDD-XXXX
  fromStoreId   String
  toStoreId     String
  requestedById String
  status        TransferStatus @default(DRAFT)
  reason        String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  fromStore   Store                 @relation("TransferRequestFrom", fields: [fromStoreId], references: [id])
  toStore     Store                 @relation("TransferRequestTo", fields: [toStoreId], references: [id])
  requestedBy User                  @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  items       TransferRequestItem[]
}

enum TransferStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  DISPATCHED
  RECEIVED
  COMPLETED
}

model TransferRequestItem {
  id         String @id @default(cuid())
  transferId String
  itemId     String
  quantity   Float

  transfer TransferRequest @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     InventoryItem   @relation(fields: [itemId], references: [id])
}

// -------------------------------------------------------------------
// DISPOSALS WORKFLOW
// -------------------------------------------------------------------

model DisposalRequest {
  id            String         @id @default(cuid())
  code          String         @unique // DISP-YYYYMMDD-XXXX
  status        DisposalStatus @default(FLAGGED)
  reason        String?
  method        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items DisposalItem[]
}

enum DisposalStatus {
  FLAGGED
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXECUTED
}

model DisposalItem {
  id         String @id @default(cuid())
  disposalId String
  itemId     String
  quantity   Float
  condition  String?

  disposal DisposalRequest @relation(fields: [disposalId], references: [id], onDelete: Cascade)
  item     InventoryItem   @relation(fields: [itemId], references: [id])
}

// -------------------------------------------------------------------
// FIXED ASSETS & USER CARDS
// -------------------------------------------------------------------

model FixedAsset {
  id                String       @id @default(cuid())
  assetNumber       String       @unique // e.g., ASTU/IT/001
  itemId            String
  serialNumber      String?
  grnId             String?
  responsibleUserId String?
  status            AssetStatus  @default(IN_USE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  item            InventoryItem @relation(fields: [itemId], references: [id])
  grn             GRN?          @relation(fields: [grnId], references: [id])
  responsibleUser User?         @relation("AssetResponsibleUser", fields: [responsibleUserId], references: [id])
}

enum AssetStatus {
  IN_STORE
  IN_USE
  MAINTENANCE
  DISPOSED
  LOST
}

model UserCard {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------------
// STOCK TRANSACTIONS (LEDGER) & RECORD CARDS
// -------------------------------------------------------------------

model StockTransaction {
  id              String          @id @default(cuid())
  code            String          @unique // TXN-YYYYMMDD-XXXX
  itemId          String
  storeId         String
  type            TransactionType
  quantity        Float           // signed: + for in, - for out
  unitCost        Float           @default(0)
  balanceBefore   Float           @default(0)
  balanceAfter    Float           @default(0)
  referenceType   String?         // "GRN", "SIV", "SRN", "TRANSFER", "ADJUSTMENT"
  referenceId     String?
  userId          String
  remarks         String?
  transactionDate DateTime        @default(now())
  createdAt       DateTime        @default(now())

  item  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  store Store         @relation(fields: [storeId], references: [id])
  user  User          @relation(fields: [userId], references: [id])

  @@index([itemId, transactionDate])
  @@index([storeId])
  @@index([type])
  @@index([referenceType, referenceId])
}

enum TransactionType {
  OPENING
  RECEIPT
  ISSUE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  OBSOLETE
  DISPOSAL
}

model StockCard {
  id              String   @id @default(cuid())
  storeId         String
  itemId          String
  transactionDate DateTime @default(now())
  transactionType String
  referenceDoc    String?
  inQty           Float    @default(0)
  outQty          Float    @default(0)
  balance         Float    @default(0)
  createdAt       DateTime @default(now())

  store Store         @relation(fields: [storeId], references: [id])
  item  InventoryItem @relation(fields: [itemId], references: [id])

  @@index([storeId, itemId, transactionDate])
}

model BinCard {
  id              String   @id @default(cuid())
  binId           String
  itemId          String
  transactionDate DateTime @default(now())
  transactionType String
  referenceDoc    String?
  inQty           Float    @default(0)
  outQty          Float    @default(0)
  balance         Float    @default(0)
  createdAt       DateTime @default(now())

  bin  Bin           @relation(fields: [binId], references: [id])
  item InventoryItem @relation(fields: [itemId], references: [id])

  @@index([binId, itemId, transactionDate])
}

// -------------------------------------------------------------------
// STOCK TAKING
// -------------------------------------------------------------------

model StockTake {
  id            String          @id @default(cuid())
  code          String          @unique // ST-YYYYMMDD-XXXX
  storeId       String
  conductedById String
  status        StockTakeStatus @default(DRAFT)
  startDate     DateTime        @default(now())
  endDate       DateTime?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  store       Store           @relation(fields: [storeId], references: [id])
  conductedBy User            @relation(fields: [conductedById], references: [id])
  items       StockTakeItem[]

  @@index([status])
  @@index([storeId])
}

enum StockTakeStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  RECONCILED
}

model StockTakeItem {
  id          String  @id @default(cuid())
  stockTakeId String
  itemId      String
  systemQty   Float
  physicalQty Float?
  variance    Float?
  remarks     String?

  stockTake StockTake     @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id])

  @@index([stockTakeId])
}

// -------------------------------------------------------------------
// GATE PASSES
// -------------------------------------------------------------------

model GatePass {
  id                String         @id @default(cuid())
  code              String         @unique // GP-YYYYMMDD-XXXX
  sivId             String?        @unique
  requestedById     String
  securityOfficerId String?
  status            GatePassStatus @default(PENDING)
  carrier           String?
  vehiclePlate      String?
  exitConfirmedAt   DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  siv             StoreIssueVoucher? @relation(fields: [sivId], references: [id])
  requestedBy     User               @relation("GatePassRequestedBy", fields: [requestedById], references: [id])
  securityOfficer User?              @relation("GatePassSecurityOfficer", fields: [securityOfficerId], references: [id])

  @@index([status])
}

enum GatePassStatus {
  PENDING
  APPROVED
  EXIT_CONFIRMED
  REJECTED
  CANCELLED
}

// -------------------------------------------------------------------
// AUDIT LOGS
// -------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  module      String
  entity      String?
  entityId    String?
  oldValue    String?
  newValue    String?
  ipAddress   String?
  description String?
  timestamp   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([timestamp])
}
